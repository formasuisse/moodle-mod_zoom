{{!
    @template mod_zoom/pooled_time_select

    24h time select for a pooled occurrence slot (a native time input would
    render AM/PM under an English browser locale, whatever Moodle's language
    is). Quarter-hour steps, plus the slot's own off-grid time when it has
    one.

    Context variables required for this template:
    * formid Owning form id (HTML5 form="" association).
    * hidden Whether the select renders pre-hidden (.zoom-occ-edit d-none).
    * timeoptions Array of {value, selected}.

    Example context (json):
    {
        "formid": "zoom-occ-move-1",
        "hidden": true,
        "timeoptions": [
            {"value": "09:00", "selected": false},
            {"value": "09:15", "selected": true}
        ]
    }
}}
<select name="newtime" {{#formid}}form="{{formid}}"{{/formid}}
        class="form-select custom-select d-inline-block w-auto{{#hidden}} zoom-occ-edit d-none{{/hidden}}">
    {{#timeoptions}}
    <option value="{{value}}"{{#selected}} selected{{/selected}}>{{value}}</option>
    {{/timeoptions}}
</select>
