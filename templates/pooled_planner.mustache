{{!
    @template mod_zoom/pooled_planner

    The plain-HTML occurrence planner for the create form.

    Row 1 is the first occurrence; empty date = row skipped. The
    mod_zoom/occurrences module reveals rows on demand, keeps the weekday
    labels in step, and fills bulk patterns (+5 daily/weekly/monthly). The
    spread/clear/add-row buttons render pre-hidden (d-none) — without JS the
    planner degrades to its always-visible first row.

    Context variables required for this template:
    * rows Array of {index, first, date (pooled_date_input context), time,
      minutes} — one per planner row, hidden until used.
    * spreads Array of {kind, label, title} bulk-fill buttons.

    Example context (json):
    {
        "rows": [
            {
                "index": 0,
                "first": true,
                "date": {
                    "name": "zoomplan_date[]",
                    "value": "2026-08-24",
                    "weekday": "",
                    "extraclasses": "mr-1"
                },
                "time": "10:15",
                "minutes": 60
            }
        ],
        "spreads": [
            {"kind": "weekly", "label": "+5 weekly", "title": "Fill five more rows, one week apart."}
        ]
    }
}}
<div class="zoom-occ-planner" data-zoom-occ-planner="1">
    {{#rows}}
    <div class="mb-1 zoom-occ-planner-row{{^first}} d-none{{/first}}" data-zoom-occ-row="{{index}}">
        {{#date}}{{> mod_zoom/pooled_date_input }}{{/date}}
        <input type="text" name="zoomplan_time[]" value="{{time}}" size="5" maxlength="5" placeholder="HH:MM"
            pattern="([01][0-9]|2[0-3]):[0-5][0-9]" class="form-control d-inline-block w-auto mr-1">
        <input type="number" name="zoomplan_minutes[]" value="{{minutes}}" min="1" max="1440" placeholder="min"
            class="form-control d-inline-block" style="width:5.5em">
        <span class="mr-1"> min </span>
        {{#spreads}}
        <button type="button" data-zoom-occ-spread="{{kind}}" class="btn btn-link btn-sm d-none px-1" title="{{title}}">{{label}}</button>
        {{/spreads}}
        <button type="button" data-zoom-occ-clearrow="1" class="btn btn-link btn-sm d-none px-1"
            aria-label="{{#str}} delete {{/str}}" title="{{#str}} delete {{/str}}">✕</button>
    </div>
    {{/rows}}
    <div class="mt-1 zoom-occ-planner-buttons d-none">
        <button type="button" data-zoom-occ-addrow="1" class="btn btn-secondary btn-sm mr-1">{{#str}} occ_planner_addrow, mod_zoom {{/str}}</button>
    </div>
</div>
